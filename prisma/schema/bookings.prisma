enum BookingStatus {
    CONFIRMED
    CANCELLED
    COMPLETED
}

model bookings {
    bookingId String        @id @default(uuid())
    bio       String        @db.Text // no length limit
    studentId String?
    tutorId   String?
    startTime DateTime
    endTime   DateTime
    status    BookingStatus @default(CONFIRMED)
    price     Int
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt
}
